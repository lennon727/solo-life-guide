.detail-page {
  min-height: 100vh;
}

.detail-hero {
  padding: 42rpx 32rpx 38rpx;
}

.detail-meta {
  font-size: 22rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.detail-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  font-weight: 850;
  line-height: 1.3;
}

.detail-summary {
  margin-top: 18rpx;
  color: #5E645E;
  font-size: 27rpx;
  line-height: 1.7;
}

.score-line {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 34rpx;
}

.score-label {
  color: #7A7E77;
  font-size: 21rpx;
}

.score-value {
  margin-top: 2rpx;
  font-size: 46rpx;
  font-weight: 850;
}

.favorite-button {
  width: 150rpx;
  height: 68rpx;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #344039;
  font-size: 24rpx;
}

.favorite-button--active {
  background: #1F5D50;
  color: #FFFFFF;
}

.detail-body {
  padding: 28rpx 28rpx 70rpx;
}

.verdict-card {
  padding: 28rpx;
  border-radius: 24rpx;
  background: #242A26;
  color: #FFFFFF;
}

.verdict-label {
  color: #A8D2C1;
  font-size: 21rpx;
  font-weight: 700;
}

.verdict-text {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.75;
}

.fit-grid {
  display: flex;
  margin-top: 20rpx;
}

.fit-box {
  width: calc(50% - 8rpx);
  padding: 24rpx;
  border-radius: 22rpx;
}

.fit-box--yes {
  margin-right: 16rpx;
  background: #E6F1EC;
}

.fit-box--no {
  background: #F3EAE5;
}

.fit-title {
  margin-bottom: 14rpx;
  font-size: 24rpx;
  font-weight: 750;
}

.fit-line {
  margin-top: 9rpx;
  color: #626760;
  font-size: 22rpx;
  line-height: 1.55;
}

.content-section {
  margin-top: 42rpx;
}

.content-section-title {
  margin-bottom: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.section-text {
  color: #5F645E;
  font-size: 27rpx;
  line-height: 1.8;
}

.check-row,
.bullet-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #FFFEFA;
}

.check-box {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin: 2rpx 18rpx 0 0;
  border: 2rpx solid #AEB4AE;
  border-radius: 10rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}

.check-row--done .check-box {
  border-color: #1F5D50;
  background: #1F5D50;
}

.check-row--done .check-text {
  color: #92968F;
  text-decoration: line-through;
}

.check-text,
.bullet-text {
  color: #4F544E;
  font-size: 26rpx;
  line-height: 1.65;
}

.bullet-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  margin: 16rpx 20rpx 0 2rpx;
  border-radius: 50%;
  background: #1F5D50;
}

.source-card {
  margin-top: 50rpx;
  padding: 26rpx;
  border: 1rpx solid #E2DED5;
  border-radius: 22rpx;
  color: #7C7F78;
}

.source-title {
  color: #4C514B;
  font-size: 24rpx;
  font-weight: 750;
}

.source-line {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.updated-at {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E7E3DB;
  font-size: 21rpx;
}
