.home-page {
  overflow: hidden;
}

.brand-line {
  display: flex;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  margin-right: 18rpx;
  border-radius: 22rpx;
  background: #1F5D50;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.brand-name {
  font-size: 29rpx;
  font-weight: 750;
}

.brand-note {
  margin-top: 4rpx;
  color: #82847D;
  font-size: 21rpx;
}

.hero-title {
  margin-top: 62rpx;
  font-size: 58rpx;
  font-weight: 850;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.hero-subtitle {
  margin-top: 18rpx;
  color: #72756D;
  font-size: 28rpx;
}

.hero-search {
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 10rpx 10rpx 10rpx 26rpx;
  border: 1rpx solid rgba(31, 93, 80, 0.14);
  border-radius: 26rpx;
  background: #FFFEFA;
  box-shadow: 0 16rpx 44rpx rgba(35, 53, 46, 0.07);
}

.hero-input {
  flex: 1;
  height: 72rpx;
  font-size: 26rpx;
}

.search-placeholder {
  color: #A5A69F;
}

.search-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 20rpx;
  background: #1F5D50;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 700;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 36rpx;
}

.category-card {
  width: calc(50% - 9rpx);
  min-height: 260rpx;
  padding: 24rpx;
  border-radius: 26rpx;
}

.category-card--food {
  margin-right: 18rpx;
  background: #FCE4D7;
}

.category-card--goods {
  background: #DDECF0;
}

.category-card--guide {
  width: 100%;
  min-height: 218rpx;
  margin-top: 18rpx;
  background: #DDEBE5;
}

.category-index {
  color: rgba(38, 43, 38, 0.48);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.category-name {
  margin-top: 22rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.category-desc {
  margin-top: 9rpx;
  color: #555B54;
  font-size: 23rpx;
  line-height: 1.5;
}

.category-count {
  margin-top: 20rpx;
  color: #6C716B;
  font-size: 21rpx;
}

.featured-scroll {
  width: calc(100% + 28rpx);
}

.featured-row {
  display: inline-flex;
  padding-right: 28rpx;
}

.editorial-card {
  margin-top: 48rpx;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #242A26;
  color: #FFFFFF;
}

.editorial-kicker {
  color: #A8D2C1;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.editorial-title {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.45;
}

.editorial-body {
  margin-top: 14rpx;
  color: #CFD5D0;
  font-size: 24rpx;
  line-height: 1.7;
}

.result-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.clear-link {
  color: #1F5D50;
  font-size: 23rpx;
}
