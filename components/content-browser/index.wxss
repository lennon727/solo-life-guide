.search-box {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 0 22rpx;
  height: 92rpx;
  border: 1rpx solid rgba(31, 93, 80, 0.12);
  border-radius: 24rpx;
  background: #FFFEFA;
}

.search-icon {
  margin-right: 14rpx;
  color: #1F5D50;
  font-size: 38rpx;
}

.search-input {
  flex: 1;
  height: 92rpx;
  font-size: 27rpx;
}

.search-placeholder {
  color: #A2A39D;
}

.clear-button {
  padding: 12rpx;
  color: #1F5D50;
  font-size: 23rpx;
}

.filter-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  padding-right: 24rpx;
}

.filter-chip {
  margin-right: 14rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #ECE8DF;
  color: #686B64;
  font-size: 23rpx;
}

.filter-chip--active {
  background: #1F5D50;
  color: #FFFFFF;
}

.result-meta {
  margin: 34rpx 0 18rpx;
  color: #898B84;
  font-size: 23rpx;
}
